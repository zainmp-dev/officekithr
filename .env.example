# =============================================================================
# OfficeKit HR — environment template
# Copy to .env and adjust. Never commit .env (see .gitignore).
# =============================================================================

# --- Site (SEO, sitemap, canonical URLs) ---
VITE_SITE_URL=https://www.officekithr.com

# --- Syncora leads (contact form + HR popup — direct POST from browser) ---
VITE_SYNCORA_LEADS_URL=https://app.syncoraai.com/api/leads/external
VITE_SYNCORA_API_KEY=sk_live_your_key_here

# --- FlowPilot blogs only (do NOT use api.officekithr.com) ---
# GET https://flowpilot.officekithr.net/api/api/blogs?page=1&limit=20&status=published
# Local dev: leave URL as proxy path; production uses FlowPilot URL automatically.
VITE_BLOG_API_URL=/api/flowpilot-blogs
VITE_BLOG_API_KEY=your_flowpilot_bearer_token

# --- Analytics (loaded after cookie consent) ---
VITE_GA_MEASUREMENT_ID=G-J60WZ10KBF
VITE_GTAG_ID=GT-KDD8X4P9
VITE_GOOGLE_ADS_ID=AW-17365780413
VITE_GOOGLE_ADS_CONVERSION=AW-17365780413/MAzACIaay74bEL2P09hA

# --- Local dev toggles (optional) ---
# VITE_DISABLE_ANALYTICS=true
